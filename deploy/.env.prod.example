# Production values live in SSM Parameter Store under /snapstock/prod/ — fetch-env.sh writes
# .env.prod from them. Copy this to .env.prod only for a local test of the production stack.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@host.docker.internal:5432/pos_system
SECRET_KEY=local-test-only
CORS_ORIGINS=["http://localhost"]
STORAGE_BACKEND=local
# Production:
# DATABASE_URL=postgresql+psycopg2://<user>:<password>@<rds-endpoint>:5432/pos_system?sslmode=require
# CORS_ORIGINS=["https://snapstock.duckdns.org"]
# STORAGE_BACKEND=s3
# S3_BUCKET=snapstock-uploads-<suffix>
# AWS_REGION=ap-southeast-1
# Password reset emails:
# FRONTEND_URL=https://snapstock.duckdns.org
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=<gmail address>
# SMTP_PASSWORD=<gmail app password>   (SecureString)
# SMTP_FROM=SnapStock <gmail address>
